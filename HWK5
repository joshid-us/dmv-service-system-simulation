import random

# ----- CONSTANT LIST -----
SERVICE_TIMES = [18.63, 36.21, 5.97]


def get_positive_int(prompt):
    """Get a valid positive integer."""
    while True:
        try:
            value = int(input(prompt))
            if value > 0:
                return value
            print("Your input must be a number greater than 0. Try again!")
        except ValueError:
            print("Your input is not an integer number.")


def get_positive_float(prompt):
    """Get a valid positive number."""
    while True:
        try:
            value = float(input(prompt))
            if value > 0:
                return value
            print("Your input must be a number greater than 0. Try again!")
        except ValueError:
            print("Your input is not a number.")


def choose_service():
    """Randomly choose DMV service based on probabilities."""
    r = random.random()

    if r <= 0.30:
        return 0
    elif r <= 0.50:
        return 1
    else:
        return 2


def find_server(server_times):
    """Return server with lowest service time."""
    lowest = min(server_times)
    return server_times.index(lowest)


def run_simulation(num_customers, num_servers):
    """Simulate the DMV service process."""
    server_times = [0.0] * num_servers

    customer_service = []
    customer_server = []
    running_totals = []

    for cid in range(num_customers):

        service_id = choose_service()
        service_time = SERVICE_TIMES[service_id]

        server_id = find_server(server_times)

        server_times[server_id] += service_time

        customer_service.append(service_id)
        customer_server.append(server_id)

        running_totals.append(server_times.copy())

    return customer_service, customer_server, running_totals, server_times


def print_customer_table(service_ids, server_ids, totals):
    """Print customer information table."""
    print("\nCustomer ID  Service ID  DMV Server ID  Total Service Time")

    for i in range(len(service_ids)):
        total = totals[i][server_ids[i]]
        print(f"{i:^11}{service_ids[i]:^12}{server_ids[i]:^16}{total:>12.2f}")


def print_server_table(server_times, shift_length):
    """Print server utilization table."""
    print("\nDMV Server ID  Total Service Time  Utilization (%)")

    for i in range(len(server_times)):
        util = (server_times[i] / shift_length) * 100
        print(f"{i:^14}{server_times[i]:>16.2f}{util:>16.2f}")


def main():
    """Main program."""
    print("DMV Service System Simulation\n")

    customers = get_positive_int("Enter the number of customers: ")
    servers = get_positive_int("Enter the number of DMV servers: ")
    shift = get_positive_float("Enter the shift length in minutes: ")

    services, assigned_servers, totals, server_times = run_simulation(
        customers, servers
    )

    print_customer_table(services, assigned_servers, totals)

    print_server_table(server_times, shift)


if __name__ == "__main__":
    main()